# graphify — merged on top of .gitignore (can only exclude more, never re-include)

# PRIVACY GATE: personal documents. .gitignore already covers these, but
# `graphify extract --no-gitignore` would sweep them in and a graph is far
# harder to un-leak than a file. Belt and braces — do not remove.
**/private/

# Raw caption fragments — large, timestamped, zero conceptual content.
# These would cost a full semantic pass and contribute nothing.
**/timed/*.json

# Machine artifacts
node_modules/
.venv/
*.lock

# NEVER index our own generated output. graphify-out/wiki/ is committed, so
# it is visible to the scanner; without this graphify re-ingests its own
# summaries and the graph starts citing itself (AI-quoting-AI feedback loop).
graphify-out/
